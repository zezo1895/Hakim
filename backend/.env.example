# ── Database (MySQL) ────────────────────────────────────
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=hakim_group
DB_SSL=true

# ── ImageKit (Cloud Storage) ────────────────────────────
IMAGEKIT_PUBLIC_KEY=xxxx
IMAGEKIT_PRIVATE_KEY=xxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/xxxx

# ── Authentication & Security ───────────────────────────
ADMIN_SECRET=choose-a-long-random-secret
JWT_SECRET=choose-a-jwt-signing-secret
CI_SECRET=choose-a-ci-deploy-secret

# ── Google Gemini AI ────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS ────────────────────────────────────────────────
# Allowed frontend origins separated by comma
FRONTEND_URL=https://your-frontend.vercel.app

# ── Server Port (Optional, Railway/Render set automatically)
PORT=5000
